# --- shared / all apps -------------------------------------------------
# Cloud Postgres (Supabase or Neon), POOLER connection string (port 6543)
DATABASE_URL=postgres://user:pass@host:6543/postgres?sslmode=require

# Shared server-side cache. Use a TLS URL (`rediss://`) in production.
# If unset or temporarily unavailable, reads safely fall back to Postgres.
REDIS_URL=redis://default:password@host:6379

# --- services/pipeline (runs on the ingestion laptop) -------------------
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
# Public instance (rate-limited to 1 req/sec, see steps/geocode.ts) by
# default. If you self-host via infra/nominatim/ (see its README — only
# worth it once the public rate limit is actually a bottleneck), point
# these at your own instance instead, e.g. http://localhost:8080.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=startup-atlas/0.1 (contact: parthsohaney04@gmail.com)

# --- apps/web -------------------------------------------------------
# No payment gateway keys — payments are manual QR + transaction-id
# verification (see BUILD_PLAN.md Phase 5). The QR code itself is a static
# image at public/upi-qr.png, not an env var.
# Self-hosted PMTiles (infra/pmtiles/README.md). Full URL to the .pmtiles
# object, e.g. https://pub-xxxxxxxx.r2.dev/maharashtra.pmtiles — leave unset
# locally, MapView.tsx falls back to the copy under apps/web/public/tiles/.
NEXT_PUBLIC_MAPTILES_URL=

# --- apps/admin -------------------------------------------------------
ADMIN_SESSION_SECRET=

# GitHub PAT with "Actions: write" on this repo — /admin/ingest uses this
# to fire discovery.yml's workflow_dispatch API (Vercel's serverless
# functions can't run a long scraping job inline). Not needed for local
# dev unless you're testing that specific button.
GH_ACTIONS_TOKEN=

# Kill-switch for every ad surface on the public site (SponsorBar + both
# AdSlotStacks on the city map — see apps/web/app/[city]/page.tsx). Unset or
# any value other than "false" = ads shown. Set to "false" to hide them.
SHOW_ADS=true

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_BUCKET_NAME=logos
# Public base URL the bucket is served from (R2 custom domain or
# pub-xxxx.r2.dev) — used to build the logo_url stored on brands.
# Also needed by apps/web (submission-approval logo uploads) and
# apps/web/lib/r2.ts (referral proof uploads), not just the pipeline.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- services/monitoring (optional, self-hosted Prometheus+Grafana) -----
# See services/monitoring/README.md. Only needed if you're running that
# docker-compose stack. Recommend a read-only Postgres role for this
# (README has the SQL) rather than reusing DATABASE_URL's owner credentials.
MONITORING_DATABASE_URL=postgres://monitoring_readonly:pass@host:5432/postgres?sslmode=require
# Neon's pooler uses port 5432, not Supabase's 6543 (see BUILD_PLAN.md Part 0)
MONITORING_PG_HOST=host:5432
MONITORING_PG_DATABASE=postgres
MONITORING_PG_USER=monitoring_readonly
MONITORING_PG_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# --- job aggregator APIs (optional) -------------------------------------
# Feeds services/pipeline's refresh-aggregator-jobs step. Both are official
# free-tier APIs with real India coverage — the ATS path (lib/ats.ts) only
# reaches companies that run a machine-readable job board, which measured at
# roughly 5% of this dataset, so these cover the rest.
# With neither set the step exits cleanly having done nothing.
#
# Adzuna: developer.adzuna.com — instant self-serve key, no card, ~1k
# calls/month on the free tier. "in" is its India country code.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: jooble.org/api/about — fill the request form, key arrives by email.
JOOBLE_API_KEY=
